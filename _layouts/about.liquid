---
layout: default
---

{% include publication_badge_style.liquid %}

<style>
/* Minimal academic landing page modeled on the clean al-folio reference layout. */
.academic-home { max-width: 930px; margin: 0 auto; }
.academic-home .post-header { margin-bottom: 1.65rem; }
.academic-home .post-title { font-size: 2.65rem; font-weight: 500; letter-spacing: -.035em; margin-bottom: .25rem; }
.academic-home .desc { font-size: .99rem; opacity: .75; }
.academic-home .academic-profile { float: right; width: 26%; max-width: 235px; margin: 0 0 1.1rem 1.8rem; }
.academic-home .academic-profile img { width: 100%; height: auto; aspect-ratio: 3 / 4; object-fit: cover; border-radius: 5px; box-shadow: 0 1px 5px rgba(0,0,0,.11); }
.academic-home .clearfix { font-size: 1rem; line-height: 1.75; }
.academic-home h2 { font-size: 1.45rem; font-weight: 500; margin-top: 1.55rem; margin-bottom: .95rem; }
.academic-home h2 a { color: inherit; text-decoration: none; }
.academic-home .publications ol.bibliography { margin: 0; padding-left: 0; }
.academic-home .publications ol.bibliography li { margin-bottom: 1.15rem; }
.academic-home .publications .title { font-size: 1rem; font-weight: 600; line-height: 1.45; }
.academic-home .publications .author, .academic-home .publications .periodical { font-size: .9rem; line-height: 1.5; }
.academic-home .publications .links { margin-top: .2rem; }
.academic-home .publications .links a.btn { font-size: .76rem; padding: .14rem .4rem; margin: .1rem .2rem .1rem 0; }
.academic-home .publications .abbr { font-size: .85rem; }
/* Compact icon-only academic contact links; works in light and dark mode. */
.academic-home .academic-contact-icons {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 0.55rem;
  margin-top: 1.5rem;
  padding-top: 0.7rem;
  border-top: 1px solid rgba(128, 128, 128, 0.16);
}
.academic-home .academic-contact-icons a {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 34px;
  height: 34px;
  padding: 0;
  color: inherit !important;
  font-size: 19px;
  line-height: 1;
  opacity: 0.68;
  border-radius: 6px;
  text-decoration: none !important;
  transition: opacity 150ms ease, background-color 150ms ease;
}
.academic-home .academic-contact-icons a:hover,
.academic-home .academic-contact-icons a:focus-visible {
  opacity: 1;
  background-color: rgba(128, 128, 128, 0.10);
}
.academic-home .academic-contact-icons a:focus-visible {
  outline: 2px solid currentColor;
  outline-offset: 2px;
}
.academic-home .academic-contact-icons i {
  display: inline-block;
  font-size: 19px !important;
  line-height: 1;
}
@media(max-width: 620px) {
  .academic-home .post-title { font-size: 2.25rem; }
  .academic-home .academic-profile { width: 35%; margin-left: 1rem; }
  .academic-home .publications .abbr { margin-bottom: .3rem; }
}
</style>

<div class="post academic-home">
  <header class="post-header">
    <h1 class="post-title">Ruxiang Duan</h1>
    <p class="desc">{{ page.subtitle }}</p>
  </header>
  <article>
    <div class="academic-profile">
      <img src="{{ '/assets/img/prof_pic.jpg' | relative_url }}" loading="eager" alt="Ruxiang Duan at VALSE 2025" width="235" height="313">
    </div>
    <div class="clearfix">{{ content }}</div>

    <h2>Recent Works</h2>
    {% include recent_works.liquid %}

    <h2>Selected Publications</h2>
    {% include selected_papers.liquid %}

    {% if page.social %}
    <nav class="academic-contact-icons" aria-label="Academic contact links">
      <a href="mailto:auduanruxiang@mail.scut.edu.cn" title="Email" aria-label="Email Ruxiang Duan"><i class="fa-solid fa-envelope" aria-hidden="true"></i></a>
      <a href="https://github.com/CNruxiangduan" title="GitHub" aria-label="GitHub"><i class="fa-brands fa-github" aria-hidden="true"></i></a>
      <a href="https://orcid.org/0009-0002-7512-1934" title="ORCID" aria-label="ORCID"><i class="fa-brands fa-orcid" aria-hidden="true"></i></a>
      <a href="{{ '/publications/' | relative_url }}" title="Publications" aria-label="Publications"><i class="fa-solid fa-file-lines" aria-hidden="true"></i></a>
    </nav>
    {% endif %}
  </article>
</div>
